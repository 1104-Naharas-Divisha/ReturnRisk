GEMINI_API_KEY=your_gemini_api_key
BRAVE_API_KEY=your_brave_search_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
RETURNRISK_TIMEZONE=America/Los_Angeles

# Use 1 only when a trusted HTTP(S) proxy is already configured.
RETURNRISK_USE_PROXY=0

# Pace model requests for free-tier use.
GEMINI_MIN_INTERVAL=4.5
